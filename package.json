{
  "name": "agentisync",
  "version": "0.1.0",
  "description": "`agentisync` is a local control plane for agent skills in a repository.",
  "type": "module",
  "bin": {
    "agentisync": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build",
    "release:check": "npm run check && npm run pack:dry-run",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daubas/agentisync.git"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "ai-agents",
    "codex",
    "claude-code"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "daubas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/daubas/agentisync/issues"
  },
  "homepage": "https://github.com/daubas/agentisync#readme",
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
